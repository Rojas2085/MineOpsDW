# Copiar a .env local; nunca rellenar secretos en archivos versionados.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
SAMPLE_INTERVAL_SECONDS=10
REPORT_INTERVAL_MINUTES=30
TELEMETRY_MODE=simulated
MAX_SESSION_MINUTES=30
MAX_CPU_PERCENT=75
MAX_CPU_TEMP_C=80
# Opcional: si se deja vacío o comentado, MineOps DW auto-detecta el TDP según la CPU del equipo.
# CPU_TDP_WATTS=
# Parámetros aprobados del Supervisor Térmico (PARAM-01 a PARAM-04)
THERMAL_CRITICAL_TEMP_C=75.0
THERMAL_RECOVERY_TEMP_C=60.0
THERMAL_STABILITY_WINDOW_SECONDS=120
THERMAL_MAX_STALENESS_SECONDS=30
# Conector pasivo loopback XMRig (PARAM-05)
XMRIG_API_URL=http://127.0.0.1:18080
XMRIG_ACCESS_TOKEN=
# Configuración de retiro vacía por defecto (PARAM-06)
PAYOUT_COIN=
PAYOUT_ADDRESS=
PAYOUT_NETWORK=
# Binance: usar solo credenciales de lectura en configuración local segura.
BINANCE_READ_ONLY_API_KEY=
BINANCE_READ_ONLY_API_SECRET=
